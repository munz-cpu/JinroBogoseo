  protocol:
    apiUrl: http://127.0.0.1:8000
    settingsVersion: combat-v2
    consentVersion: consent-v5
    consentNotice: "\uBCF4\uC2A4\uC804\uC5D0 \uB3C4\uC804\uD574 \uBCF4\uACE0, \uACF5\uACA9\uC744 \uD53C\uD558\uB294 \uC7AC\uBBF8\uC640 \uC804\uD22C \uB09C\uC774\uB3C4\uAC00 \uC5B4\uB560\uB294\uC9C0 \uC54C\uB824\uC8FC\uC138\uC694. \uD559\uAD50 \uC5F0\uAD6C\uC6A9 \uD50C\uB808\uC774\uD14C\uC2A4\uD2B8\uC608\uC694. \uC790\uC138\uD55C \uC5F0\uAD6C \uC9C8\uBB38\uACFC \uD50C\uB808\uC774 \uC870\uAC74\uC740 \uB05D\uB09C \uB4A4 \uC54C\uB824\uB4DC\uB824\uC694.\n\n\uB3C4\uC804 \uD69F\uC218, \uC2DC\uAC04, \uD53C\uD574\uB7C9, \uC804\uD22C \uC9C4\uD589\uACFC \uB09C\uC774\uB3C4 \uC870\uC815 \uAE30\uB85D, \uBCC4\uC810\uC744 \uCC38\uAC00\uC790 ID\uB85C \uC5F0\uACB0\uD574 \uAE30\uB85D\uD574\uC694. \uCC38\uC5EC\uB294 \uC790\uC720\uC774\uACE0 \uC5B8\uC81C\uB4E0 \uADF8\uB9CC\uB458 \uC218 \uC788\uC5B4\uC694."
    retention: "\uC120\uB9B0\uC778\uD130\uB137\uACE0\uB4F1\uD559\uAD50"
    contact: s26108@sunrint.hs.kr
    debrief: "\uD50C\uB808\uC774\uD574 \uC8FC\uC154\uC11C \uACE0\uB9C8\uC6CC\uC694! \uC774\uBC88 \uD14C\uC2A4\uD2B8\uC5D0\uC11C\uB294 \uBCF4\uC2A4\uC5D0\uAC8C \uBA87 \uBC88 \uB3C4\uC804\uD588\uB294\uC9C0\uC640 \uD50C\uB808\uC774 \uC911 \uB290\uB080 \uC131\uCDE8\uAC10\uC774 \uC5B4\uB5A4 \uAD00\uACC4\uC778\uC9C0 \uC0B4\uD3B4\uBD10\uC694. \uC774 \uC9C8\uBB38\uC744 \uBBF8\uB9AC \uC54C\uBA74 \uD50C\uB808\uC774 \uBC29\uC2DD\uC5D0 \uC601\uD5A5\uC744 \uC904 \uC218 \uC788\uC5B4\uC11C \uB05D\uB09C \uB4A4\uC5D0 \uC54C\uB824\uB4DC\uB824\uC694.\n\n\uBAA9\uD45C \uB3C4\uC804 \uD69F\uC218\uB294 \uCC38\uAC00\uC790\uB9C8\uB2E4 \uBB34\uC791\uC704\uB85C \uBC30\uC815\uB410\uC5B4\uC694. \uB3C4\uC804 \uC0AC\uC774\uC5D0 \uC804\uD22C \uAE30\uB85D\uACFC \uBAA9\uD45C\uAE4C\uC9C0 \uB0A8\uC740 \uD69F\uC218\uC5D0 \uB530\uB77C \uBCF4\uC2A4\uC758 \uACF5\uACA9\uACFC \uCCB4\uB825\uC774 \uC870\uC815\uB410\uACE0, \uBAA9\uD45C \uD69F\uC218 \uC804\uC5D0\uB3C4 \uD074\uB9AC\uC5B4\uD560 \uC218 \uC788\uC5C8\uC5B4\uC694. \uC6D0\uD558\uBA74 \uC544\uB798 \uBC84\uD2BC\uC73C\uB85C \uC5F0\uAD6C \uB370\uC774\uD130 \uC81C\uC678\uB97C \uC694\uCCAD\uD560 \uC218 \uC788\uC5B4\uC694."
    minimumLevel: 0
    maximumLevel: 1
    initialLevel: 0.48
    maximumStep: 0.12
